{
  "name": "local-studio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "video:studio": "remotion studio video/index.ts",
    "video:render": "remotion render video/index.ts LocalStudioTour public/media/recordings/local-studio-product-tour.mp4 --codec=h264 --crf=22",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@remotion/cli": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.8",
    "remotion": "4.0.489",
    "typescript": "^5.7.2",
    "wrangler": "^4.147.0",
    "zod": "4.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261001.1": true
  }
}
